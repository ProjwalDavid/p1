import win32com.client
import pandas as pd
import re
import os
from datetime import datetime, timedelta, timezone

# =====================================================
# CONFIG
# =====================================================

DAYS_TO_DOWNLOAD = 365

# Emails where any of these addresses appear in TO or CC are skipped
EXCLUDE_RECIPIENTS = {
    "mayur.meshram@mahindrafinance.com",
}

timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
OUTPUT_FILE = fr"D:\email_xxxinventory_excl_mayur_{timestamp}.xlsx"
TRACKING_FILE = r"D:\proces_excl_mayur.csv"   # separate file so it doesn't clash with the old run

EXCLUDE_RECIPIENTS = {e.strip().lower() for e in EXCLUDE_RECIPIENTS}

# =====================================================
# LOAD PROCESSED IDS
# =====================================================

processed_ids = set()

if os.path.exists(TRACKING_FILE):
    try:
        processed_df = pd.read_csv(TRACKING_FILE)
        processed_ids = set(processed_df["entry_id"].astype(str))
        print(f"Loaded {len(processed_ids)} processed IDs")
    except Exception as e:
        print(f"Could not read tracking file: {e}")

new_processed = []

# =====================================================
# HELPERS
# =====================================================

PR_SMTP_ADDRESS = "http://schemas.microsoft.com/mapi/proptag/0x39FE001E"


def get_smtp_address(recipient):
    """Resolve a recipient to an SMTP address (handles Exchange EX: addresses)."""
    try:
        exch_user = recipient.AddressEntry.GetExchangeUser()
        if exch_user and exch_user.PrimarySmtpAddress:
            return exch_user.PrimarySmtpAddress
    except Exception:
        pass

    try:
        addr = recipient.PropertyAccessor.GetProperty(PR_SMTP_ADDRESS)
        if addr:
            return addr
    except Exception:
        pass

    try:
        return recipient.Address
    except Exception:
        return None


def clean_body(body_raw):
    body = body_raw or ""
    patterns = [
        r"(?is)-----Original Message-----.*",
        r"(?is)From:.*?Sent:.*",
    ]
    for p in patterns:
        body = re.sub(p, "", body)
    return body.strip()


# =====================================================
# OUTLOOK CONNECTION
# =====================================================

outlook = win32com.client.Dispatch("Outlook.Application")
namespace = outlook.GetNamespace("MAPI")

inbox = namespace.GetDefaultFolder(6)
messages = inbox.Items
messages.Sort("[ReceivedTime]", True)

# =====================================================
# DATE FILTER
# =====================================================

cutoff_utc = datetime.now(timezone.utc) - timedelta(days=DAYS_TO_DOWNLOAD)
extract_timestamp = datetime.now(timezone.utc).isoformat()
local_tz = datetime.now().astimezone().tzinfo

records = []
excluded_count = 0

# =====================================================
# PROCESS EMAILS
# =====================================================

for msg in messages:
    try:
        if msg.MessageClass != "IPM.Note":
            continue

        # ---------------- TIME (check first so we can stop early) ----------------
        received_local = pd.Timestamp(msg.ReceivedTime)
        if received_local.tzinfo is None:
            received_local = received_local.tz_localize(local_tz)
        received_utc = received_local.tz_convert("UTC")

        if received_utc.to_pydatetime() < cutoff_utc:
            break

        entry_id = str(msg.EntryID)
        if entry_id in processed_ids:
            continue

        # ---------------- RECIPIENTS ----------------
        to_emails, cc_emails = [], []

        for r in msg.Recipients:
            email = get_smtp_address(r)
            if not email:
                continue
            if r.Type == 1:      # TO
                to_emails.append(email)
            elif r.Type == 2:    # CC
                cc_emails.append(email)

        # ---------------- EXCLUSION FILTER ----------------
        all_recipients = {e.strip().lower() for e in to_emails + cc_emails}
        if all_recipients & EXCLUDE_RECIPIENTS:
            excluded_count += 1
            continue

        to_emails = ",".join(sorted(set(to_emails)))
        cc_emails = ",".join(sorted(set(cc_emails)))
        recipient_count = msg.Recipients.Count

        # ---------------- SENDER ----------------
        sender_name = None
        sender_email = None

        try:
            sender_name = msg.SenderName
        except Exception:
            pass

        try:
            exch_user = msg.Sender.GetExchangeUser()
            if exch_user:
                sender_email = exch_user.PrimarySmtpAddress
        except Exception:
            pass

        if not sender_email:
            try:
                sender_email = msg.SenderEmailAddress
            except Exception:
                pass

        # ---------------- SUBJECT / BODY ----------------
        subject = str(msg.Subject or "")

        try:
            body_clean = clean_body(msg.Body)
        except Exception:
            body_clean = ""

        # ---------------- CONVERSATION ----------------
        try:
            conversation_id = msg.ConversationID
        except Exception:
            conversation_id = None

        try:
            conversation_topic = msg.ConversationTopic
        except Exception:
            conversation_topic = None

        # ---------------- RECORD ----------------
        records.append({
            "extract_timestamp": extract_timestamp,
            "entry_id": entry_id,
            "conversation_id": conversation_id,
            "conversation_topic": conversation_topic,
            "sender_name": sender_name,
            "sender_email": sender_email,
            "to_emails": to_emails,
            "cc_emails": cc_emails,
            "recipient_count": recipient_count,
            "subject": subject,
            "received_local": received_local.isoformat(),
            "received_utc": received_utc.isoformat(),
            "attachment_count": msg.Attachments.Count,
            "body_clean": body_clean,
        })

        new_processed.append({
            "entry_id": entry_id,
            "processed_timestamp": extract_timestamp,
        })

    except Exception as e:
        print(e)

# =====================================================
# WRITE OUTPUT
# =====================================================

df = pd.DataFrame(records)

if len(df) > 0:
    df = df.astype(str)
    df.to_excel(OUTPUT_FILE, index=False)

if len(new_processed) > 0:
    tracking_df = pd.DataFrame(new_processed)
    if os.path.exists(TRACKING_FILE):
        tracking_df.to_csv(TRACKING_FILE, mode="a", header=False, index=False)
    else:
        tracking_df.to_csv(TRACKING_FILE, index=False)

# =====================================================
# SUMMARY
# =====================================================

print("=" * 60)
print(f"New Emails Processed : {len(df)}")
print(f"Excluded (Mayur TO/CC): {excluded_count}")
print(f"Tracking Records     : {len(new_processed)}")
print(f"Output File          : {OUTPUT_FILE}")
print(f"Tracking File        : {TRACKING_FILE}")
print("=" * 60)
