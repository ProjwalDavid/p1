%sql
CREATE OR REPLACE TEMPORARY VIEW glb as
SELECT ENTITY_CODE as global_cif, ENTITY_TYPE as Customer_variant, CLUSTER_ID  FROM mmfsl_prod.fusion_silverplus.contract_cust_cluster_id_link WHERE REFERENCE_NUMBER in (SELECT new_hpano FROM mm);

%sql
CREATE or REPLACE TEMp view coap as 
  SELECT APPLICATION_NUMBER as NEW_HPANO ,NEO_CIF AS Customer_ID, CO_BORROWER_NAME as CO_BORROWER_NAME,'co-borrower' AS Identifier
  FROM finnone_silver.dim_cas_co_borrowers
  WHERE application_number in (SELECT new_hpano FROM mm);
%sql
CREATE or replace temp view app as 
 SELECT DISTINCT `Loan_Account_#`,Customer_ID,Customer_Name ,'applicant_id' AS Identifier
  FROM finnone_silver.fct_loan_details
  WHERE `Loan_Account_#` in (SELECT new_hpano FROM mm);
%sql
CREATE or REPLACE TEMp view gu as 
  SELECT APPLICATION_NUMBER as NEW_HPANO ,NEO_CIF AS Customer_ID,GUARANTOR_NAME ,'guarantor' AS Identifier
  FROM finnone_silver.dim_cas_guarantor
  WHERE application_number in (SELECT new_hpano FROM mm)


