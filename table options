# ----------------------------------------------------------------------------- data classes
@dataclass(frozen=True)
class Event:
    cell_no: int
    source_kind: str                       # SQL | PYSPARK
    access_type: str                       # READ | WRITE
    candidates: Tuple[TableKey, ...]
    column: Optional[str]                  # None => table-level event
    resolution: str


@dataclass(frozen=True)
class DF:
    """What we know about a DataFrame variable / expression."""
    tables: FrozenSet[TableKey]
    derived: FrozenSet[str] = frozenset()  # columns created in code (not physical)
    writer: bool = False                   # df.write / df.writeStream chain
    aliases: FrozenSet[Tuple[str, FrozenSet[TableKey]]] = frozenset()   # df.alias("c")
    union: bool = False                    # built by union(): a column comes from *every* source


@dataclass
class Script:
    path: str
    script_type: str                       # NOTEBOOK | FILE
    language: str                          # python | sql | scala | r
