# ----------------------------------------------------------------------------- helpers
def placeholder(name: str) -> str:
    """Identifier-safe stand-in for an unresolved variable, e.g. {env} -> __env__."""
    return "__" + re.sub(r"\W+", "_", name).strip("_") + "__"


PH_RX = re.compile(r"__([A-Za-z0-9]+(?:_[A-Za-z0-9]+)*?)__")


def pretty(name: str) -> str:
    """__env___audit -> {env}_audit for display."""
    if not name or name in (NOCAT, NODB, TV):
        return "" if name in (NOCAT, NODB) else (name or "")
    return PH_RX.sub(lambda m: "{" + m.group(1) + "}", name)


def split_ident(s: str) -> List[str]:
    """Split 'cat.`my schema`.tbl' into parts, respecting backticks."""
    parts, cur, q = [], "", False
    for ch in s.strip():
        if ch == "`":
            q = not q
        elif ch == "." and not q:
            parts.append(cur)
            cur = ""
        else:
            cur += ch
    parts.append(cur)
    return [p.strip().lower() for p in parts if p.strip()]


def clean_col(name: str) -> str:
    name = name.strip().strip("`").strip()
    if "." in name:                        # alias.col -> col
        name = name.split(".")[-1].strip("`")
    return name.lower()


SQL_VAR_PATTERNS = [
    (re.compile(r"\$\{([^}]+)\}"), lambda m: placeholder(m.group(1))),        # ${var}
    (re.compile(r"\{\{\s*(\w+)\s*\}\}"), lambda m: placeholder(m.group(1))),  # {{var}}
    (re.compile(r"\{(\w+)\}"), lambda m: placeholder(m.group(1))),            # {var}
    (re.compile(r"(?<![\w:]):(?!:)([A-Za-z_]\w*)"), lambda m: placeholder(m.group(1))),  # :param
    (re.compile(r"\$([A-Za-z_]\w*)"), lambda m: placeholder(m.group(1))),     # $var
]


def preprocess_sql(sql: str) -> str:
    for pat, fn in SQL_VAR_PATTERNS:
        sql = pat.sub(fn, sql)
    return sql


def split_sql_statements(sql: str) -> List[str]:
    """Split on ';' outside quotes/comments."""
    out, buf, i, n = [], [], 0, len(sql)
    quote = None
    while i < n:
        c = sql[i]
        if quote:
            buf.append(c)
            if c == "\\" and i + 1 < n:
                buf.append(sql[i + 1]); i += 2; continue
            if c == quote:
                quote = None
        elif c in "'\"`":
            quote = c; buf.append(c)
        elif sql.startswith("--", i):
            j = sql.find("\n", i)
            j = n if j == -1 else j
            buf.append(sql[i:j]); i = j; continue
        elif sql.startswith("/*", i):
            j = sql.find("*/", i + 2)
            j = n if j == -1 else j + 2
            buf.append(sql[i:j]); i = j; continue
        elif c == ";":
            out.append("".join(buf)); buf = []
        else:
            buf.append(c)
        i += 1
    out.append("".join(buf))
    return [s for s in (x.strip() for x in out) if s and not re.fullmatch(r"(--[^\n]*\s*)+", s)]


def qualify_kwargs(**kw):
    """Pass only the options this sqlglot version supports."""
    import inspect
    params = inspect.signature(qualify).parameters
    accepts_any = any(p.kind == p.VAR_KEYWORD for p in params.values())
    out = {k: v for k, v in kw.items() if k in params or (accepts_any and k not in ("infer_schema",))}
    out["dialect"] = DIALECT
    return out


# ----------------------------------------------------------------------------- notebook splitting
CELL_SEP = re.compile(r"^[ \t]*(?:#|--|//)[ \t]*COMMAND -{3,}[ \t]*$", re.M)
NB_HEADER = re.compile(r"^[ \t]*(?:#|--|//)[ \t]*Databricks notebook source[ \t]*$", re.M)
MAGIC = re.compile(r"^[ \t]*(?:#|--|//) ?MAGIC ?")
LANG_ALIASES = {"python": "python", "py": "python", "sql": "sql", "scala": "scala", "r": "r"}


def split_cells(text: str, default_lang: str) -> List[Tuple[int, str, str]]:
    """Return [(cell_no, language, code)] for a Databricks SOURCE export (or a plain file)."""
    if text.lstrip().startswith("{") and '"cells"' in text[:5000]:
        return split_ipynb(text, default_lang)
    text = NB_HEADER.sub("", text, count=1)
    cells = []
    for i, raw in enumerate(CELL_SEP.split(text), 1):
        lines = raw.split("\n")
        nonblank = [l for l in lines if l.strip()]
        if not nonblank:
            continue
        lang, body = default_lang, raw
        if all(MAGIC.match(l) for l in nonblank):
            stripped = [MAGIC.sub("", l, count=1) if l.strip() else "" for l in lines]
            first_idx = next(k for k, l in enumerate(stripped) if l.strip())
            m = re.match(r"\s*%(\w+)", stripped[first_idx])
            if m:
                magic = m.group(1).lower()
                if magic not in LANG_ALIASES:
                    continue                       # %md, %run, %pip, %sh, %fs ...
                lang = LANG_ALIASES[magic]
                stripped[first_idx] = stripped[first_idx].replace("%" + m.group(1), "", 1)
            body = "\n".join(stripped)
        cells.append((i, lang, body))
    return cells


def split_ipynb(text: str, default_lang: str) -> List[Tuple[int, str, str]]:
    try:
        nb = json.loads(text)
    except Exception:
        return [(1, default_lang, text)]
    out = []
    for i, c in enumerate(nb.get("cells", []), 1):
        if c.get("cell_type") != "code":
            continue
        src = c.get("source", "")
        src = "".join(src) if isinstance(src, list) else src
        lang = default_lang
        m = re.match(r"\s*%(\w+)", src)
        if m:
            magic = m.group(1).lower()
            if magic not in LANG_ALIASES:
                continue
            lang = LANG_ALIASES[magic]
            src = src.replace("%" + m.group(1), "", 1)
        out.append((i, lang, src))
    return out


