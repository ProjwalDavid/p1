# ----------------------------------------------------------------------------- Databricks mode
def databricks_main():
    from databricks.sdk import WorkspaceClient
    from databricks.sdk.service.workspace import ExportFormat, ObjectType

    me = spark.sql("SELECT current_user()").first()[0]  # noqa: F821
    dbutils.widgets.text("scan_paths", f"/Users/{me},/Repos/{me}", "1. Folders to scan (comma-separated)")  # noqa: F821
    dbutils.widgets.text("exclude_patterns", "*/.Trash*,*/.ipynb_checkpoints/*", "2. Exclude globs")  # noqa: F821
    dbutils.widgets.text("default_catalog", "", "3. Default catalog (blank = current)")  # noqa: F821
    dbutils.widgets.text("default_schema", "", "4. Default schema (blank = current)")  # noqa: F821
    dbutils.widgets.dropdown("verify_with_information_schema", "yes", ["yes", "no"], "5. Verify columns")  # noqa: F821
    dbutils.widgets.text("output_csv", f"/Workspace/Users/{me}/table_column_usage.csv", "6. Output CSV")  # noqa: F821
    dbutils.widgets.text("output_table", "", "7. Output Delta table (optional, cat.schema.tbl)")  # noqa: F821

    W = dbutils.widgets.get  # noqa: F821
    roots = [p.strip().rstrip("/") or "/" for p in W("scan_paths").split(",") if p.strip()]
    excludes = [p.strip() for p in W("exclude_patterns").split(",") if p.strip()]
    default_catalog = W("default_catalog") or spark.sql("SELECT current_catalog()").first()[0]  # noqa: F821
    default_schema = W("default_schema") or spark.sql("SELECT current_schema()").first()[0]  # noqa: F821
    verify = W("verify_with_information_schema") == "yes"
    out_csv, out_table = W("output_csv").strip(), W("output_table").strip()
    print(f"Defaults: catalog={default_catalog}, schema={default_schema}")

    w = WorkspaceClient()

    # --- 1. list
    objects = []
    stack = list(roots)
    seen = set()
    while stack:
        p = stack.pop()
        if p in seen:
            continue
        seen.add(p)
        try:
            items = list(w.workspace.list(p))
        except Exception as e:
            print(f"   skip {p}: {str(e)[:120]}")
            continue
        for o in items:
            if any(fnmatch.fnmatch(o.path, pat) for pat in excludes):
                continue
            if o.object_type in (ObjectType.DIRECTORY, ObjectType.REPO):
                stack.append(o.path)
            elif o.object_type == ObjectType.NOTEBOOK:
                objects.append(o)
            elif o.object_type == ObjectType.FILE and os.path.splitext(o.path)[1].lower() in EXT_LANG:
                objects.append(o)
    print(f"Found {len(objects)} notebooks/files under {roots}")

    # --- 2. export
    def fetch(o):
        lang = (o.language.value.lower() if o.language else
                EXT_LANG.get(os.path.splitext(o.path)[1].lower(), "python"))
        stype = "NOTEBOOK" if o.object_type == ObjectType.NOTEBOOK else "FILE"
        text = None
        for fmt in (ExportFormat.SOURCE, ExportFormat.AUTO):
            try:
                text = base64.b64decode(w.workspace.export(o.path, format=fmt).content or b"").decode("utf-8", "replace")
                break
            except Exception:
                continue
        if text is None and stype == "FILE":
            try:
                with open("/Workspace" + o.path, encoding="utf-8", errors="replace") as fh:
                    text = fh.read()
            except Exception:
                pass
        return Script(o.path, stype, lang, text) if text else None

    with ThreadPoolExecutor(max_workers=8) as pool:
        scripts = [s for s in pool.map(fetch, objects) if s]
    print(f"Exported {len(scripts)} scripts")

    # --- 3. schema fetcher (information_schema, then per-table fallback)
    def fetch_schema(tables: Set[TableKey]) -> Dict[TableKey, Set[str]]:
        result: Dict[TableKey, Set[str]] = {}
        by_cat: Dict[str, Set[TableKey]] = {}
        for t in tables:
            by_cat.setdefault(t[0], set()).add(t)
        for cat, keys in by_cat.items():
            if cat == "hive_metastore":
                continue
            keys = sorted(keys)
            for i in range(0, len(keys), 300):
                chunk = keys[i:i + 300]
                in_list = ",".join("'" + f"{s}.{t}".replace("'", "''") + "'" for _, s, t in chunk)
                q = (f"SELECT lower(table_schema) s, lower(table_name) t, lower(column_name) c "
                     f"FROM `{cat}`.information_schema.columns "
                     f"WHERE lower(concat(table_schema, '.', table_name)) IN ({in_list})")
                try:
                    for r in spark.sql(q).collect():  # noqa: F821
                        result.setdefault((cat, r["s"], r["t"]), set()).add(r["c"])
                except Exception as e:
                    print(f"   information_schema unavailable for {cat}: {str(e)[:100]}")
                    break
        missing = [t for t in tables if t not in result]
        for t in missing[:500]:                        # views / hive_metastore / no info-schema access
            try:
                fq = ".".join(f"`{p}`" for p in t)
                result[t] = {c.lower() for c in spark.table(fq).columns}  # noqa: F821
            except Exception:
                pass
        return result

    rows = run_scan(scripts, default_catalog, default_schema,
                    fetch_schema=fetch_schema if verify else None)
    print_summary(rows)

    # --- 4. save
    if out_csv:
        try:
            write_csv(rows, out_csv)
            print(f"Saved CSV -> {out_csv}")
        except Exception as e:
            print(f"Could not write {out_csv}: {e}")
    import pandas as pd
    pdf = pd.DataFrame(rows, columns=OUTPUT_COLUMNS).astype({"cell_no": "int64"})
    sdf = spark.createDataFrame(pdf) if len(pdf) else None  # noqa: F821
    if out_table and sdf is not None:
        sdf.write.mode("overwrite").option("overwriteSchema", "true").saveAsTable(out_table)
        print(f"Saved table -> {out_table}")
    if sdf is not None:
        display(sdf)  # noqa: F821


# COMMAND ----------

if IN_DATABRICKS:
    databricks_main()
elif __name__ == "__main__":
    main_cli()
